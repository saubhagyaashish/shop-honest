# Copy to backend/.env (git-ignored) and adjust. Every setting: docs/ARCHITECTURE.md §13.

# Which model judges live audits: replay (no model, measured checks only) · ollama · gemini
MODEL_PROVIDER=replay

# Local model (MODEL_PROVIDER=ollama): `ollama pull gemma3:4b`
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemini (MODEL_PROVIDER=gemini): a free key from https://aistudio.google.com. Never commit it.
# GOOGLE_API_KEY=
# Confirm these against the models your key can use.
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-pro
