# Copy to backend/.env (git-ignored) and adjust. Every setting: docs/ARCHITECTURE.md §13.

# Which model judges live audits: replay (no model, measured checks only) · ollama · gemini
MODEL_PROVIDER=replay

# Local model (MODEL_PROVIDER=ollama): `ollama pull gemma3:4b`
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemini (MODEL_PROVIDER=gemini) through Vertex AI: uses your gcloud application-default login
# locally and the service account on Cloud Run, so there's no key. Models live on the global endpoint.
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=shop-honest-72fd8
GOOGLE_CLOUD_LOCATION=global
# Chosen by the answer-key eval: 2.5-pro and 3.1-pro-preview scored the same, at more cost.
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_SMART=gemini-3.8-flash

# Or through Google AI Studio instead: GEMINI_BACKEND=ai_studio and a key. Never commit it.
# GOOGLE_API_KEY=
