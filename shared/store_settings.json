{
  "settings": [
    {
      "key": "behaviour.resettingTimer",
      "type": "boolean",
      "description": "On: the deal countdown restarts from 10:00 on every page load. Off: it counts down to a fixed end time.",
      "fixes": [
        "false_urgency"
      ]
    },
    {
      "key": "behaviour.frozenStock",
      "type": "boolean",
      "description": "On: \"Only 2 left!\" is shown whatever happens. Off: the stock shown comes from live inventory.",
      "fixes": [
        "false_urgency"
      ]
    },
    {
      "key": "behaviour.autoAddProtection",
      "type": "boolean",
      "description": "On: a ₹199 protection plan is put in the cart along with the product. Off: it is offered in the cart as an unticked option.",
      "fixes": [
        "basket_sneaking"
      ]
    },
    {
      "key": "behaviour.feesAtPaymentOnly",
      "type": "boolean",
      "description": "On: platform, handling and convenience fees (₹97 in all) are first added at the payment step. Off: those fees are not added at payment, so to keep charging them, set upfrontPlatformFee to their total and they show from the product page.",
      "fixes": [
        "drip_pricing"
      ]
    },
    {
      "key": "behaviour.guiltDeclinePopup",
      "type": "boolean",
      "description": "On: an offer popup whose decline link guilt-trips the shopper. Off: no such popup.",
      "fixes": [
        "confirm_shaming",
        "interface_interference",
        "nagging"
      ]
    },
    {
      "key": "behaviour.membershipTickedByDefault",
      "type": "boolean",
      "description": "On: the paid BazaarNest Plus membership (₹99/month) is ticked at checkout, its terms in fine print. Off: it starts unticked.",
      "fixes": [
        "subscription_trap",
        "basket_sneaking"
      ]
    },
    {
      "key": "behaviour.lopsidedDeliveryChoice",
      "type": "boolean",
      "description": "On: express delivery is a big orange button and standard delivery a tiny grey link. Off: both are shown as equal options.",
      "fixes": [
        "interface_interference"
      ]
    },
    {
      "key": "behaviour.buyersClaim",
      "type": "boolean",
      "description": "On: shows \"120+ bought in the last 24 hours\" with no data behind it. Off: no such claim.",
      "fixes": [
        "false_urgency"
      ]
    },
    {
      "key": "upfrontPlatformFee",
      "type": "number",
      "description": "A fee (₹) charged on every order and shown from the product page onwards (\"+ ₹9 platform fee per order\"). 0 shows none.",
      "fixes": [
        "drip_pricing"
      ]
    },
    {
      "key": "mrp.sonicbuds-pro",
      "type": "number",
      "description": "The M.R.P. (₹) shown crossed out next to the selling price of SonicBuds Pro ANC Wireless Earbuds.",
      "fixes": [
        "misleading_price"
      ]
    },
    {
      "key": "mrp.pulsefit-2",
      "type": "number",
