{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentName": {
      "enum": [
        "navigator",
        "pattern_analyst",
        "evidence",
        "price_historian",
        "seller_trust",
        "adjudicator",
        "reporter"
      ],
      "type": "string"
    },
    "AuditEvent": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "auditId": {
              "type": "string"
            },
            "startedAt": {
              "type": "string"
            },
            "targetUrl": {
              "type": "string"
            },
            "type": {
              "const": "audit.started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "auditId",
            "targetUrl",
            "startedAt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "step": {
              "$ref": "#/definitions/JourneyStep"
            },
            "type": {
              "const": "step.started",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "step",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "screenshotUrl": {
              "type": "string"
            },
            "step": {
              "$ref": "#/definitions/JourneyStep"
            },
            "type": {
              "const": "step.captured",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "step",
            "url",
            "screenshotUrl"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "screenshotUrl": {
              "type": "string"
            },
            "step": {
              "$ref": "#/definitions/JourneyStep"
            },
            "type": {
              "const": "step.blocked",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "step",
            "url",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "$ref": "#/definitions/AgentName"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "const": "agent.log",
              "type": "string"
            }
          },
          "required": [
            "type",
            "agent",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "step": {
              "$ref": "#/definitions/JourneyStep"
            },
            "total": {
              "$ref": "#/definitions/Money"
            },
            "type": {
              "const": "price.observed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "step",
            "label",
            "total"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "finding": {
              "$ref": "#/definitions/Finding"
            },
            "type": {
              "const": "finding",
              "type": "string"
            }
          },
          "required": [
            "type",
            "finding"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "report": {
              "$ref": "#/definitions/AuditReport"
            },
            "type": {
              "const": "audit.completed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "report"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "string"
            },
            "type": {
              "const": "audit.failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "AuditReport": {
      "additionalProperties": false,
      "properties": {
        "auditId": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "exposure": {
          "$ref": "#/definitions/Exposure",
          "description": "Money and law. Optional so older backends still render."
        },
        "findings": {
          "items": {
            "$ref": "#/definitions/Finding"
          },
          "type": "array"
        },
        "startedAt": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/StepCapture"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "targetUrl": {
          "type": "string"
        },
        "trustScore": {
          "description": "0–100, see auditor/score.ts.",
          "type": "number"
        }
      },
      "required": [
        "auditId",
        "targetUrl",
        "startedAt",
        "completedAt",
        "trustScore",
        "steps",
        "findings",
        "summary"
      ],
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "description": "Bounding box as fractions (0–1) of the screenshot's width and height.",
      "properties": {
        "h": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "type": "object"
    },
    "CurrencyCode": {
      "enum": [
        "INR",
        "SGD",
        "GBP",
        "EUR",
        "USD",
        "KRW",
        "AUD"
      ],
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "elementText": {
          "type": "string"
        },
        "frames": {
          "description": "More than one frame when the proof is a comparison, e.g. before/after reload.",
          "items": {
            "$ref": "#/definitions/EvidenceFrame"
          },
          "type": "array"
        },
        "observations": {
          "description": "Concrete measurements the agent made, e.g. \"Timer read 09:55, then 10:00 after reload\".",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "frames",
        "observations"
      ],
      "type": "object"
    },
    "EvidenceFrame": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/definitions/BBox"
        },
        "caption": {
          "type": "string"
        },
        "screenshotUrl": {
          "type": "string"
        }
      },
      "required": [
        "screenshotUrl",
        "caption"
      ],
      "type": "object"
    },
    "Exposure": {
      "additionalProperties": false,
      "properties": {
        "disclaimer": {
          "type": "string"
        },
        "jurisdictions": {
          "items": {
            "$ref": "#/definitions/JurisdictionExposure"
          },
          "type": "array"
        },
        "priceDrift": {
          "$ref": "#/definitions/PriceDrift"
        },
        "strictest": {
          "$ref": "#/definitions/JurisdictionCode",
          "description": "Strictest regime currently in force, used for the headline risk."
        }
      },
      "required": [
        "priceDrift",
        "jurisdictions",
        "disclaimer"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "description": "0–1, as scored by the adjudicator.",
          "type": "number"
        },
        "detectedBy": {
          "$ref": "#/definitions/AgentName"
        },
        "evidence": {
          "$ref": "#/definitions/Evidence"
        },
        "explanation": {
          "description": "The agent's reasoning in plain language.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "pageUrl": {
          "type": "string"
        },
        "patternId": {
          "$ref": "#/definitions/PatternId"
        },
        "remediation": {
          "description": "What the business should change.",
          "type": "string"
        },
        "rule": {
          "$ref": "#/definitions/RuleCitation",
          "description": "Primary citation (India). Other jurisdictions are in AuditReport.exposure."
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "status": {
          "$ref": "#/definitions/FindingStatus"
        },
        "step": {
          "$ref": "#/definitions/JourneyStep"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "patternId",
        "title",
        "explanation",
        "severity",
        "confidence",
        "status",
        "step",
        "pageUrl",
        "rule",
        "detectedBy",
        "evidence",
        "remediation"
      ],
      "type": "object"
    },
    "FindingStatus": {
      "description": "Adjudicator outcome: asserted in the report, or sent to a human.",
      "enum": [
        "confirmed",
        "needs_review"
      ],
      "type": "string"
    },
    "JourneyStep": {
      "enum": [
        "product",
        "variant",
        "cart",
        "checkout",
        "payment"
      ],
      "type": "string"
    },
    "JurisdictionCode": {
      "enum": [
        "IN",
        "SG",
        "GB",
        "EU",
        "US",
        "KR",
        "AU"
      ],
      "type": "string"
    },
    "JurisdictionExposure": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "$ref": "#/definitions/Record%3Cstring%2CRuleCitation%3E",
          "description": "Rule each finding breaches here, keyed by finding id."
        },
        "code": {
          "$ref": "#/definitions/JurisdictionCode"
        },
        "law": {
          "type": "string"
        },
        "maxPenalty": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "penaltyHeadline": {
          "description": "One short line for at-a-glance cards, e.g. \"Up to 10% of global turnover\".",
          "type": "string"
        },
        "precedents": {
          "items": {
            "$ref": "#/definitions/Precedent"
          },
          "type": "array"
        },
        "regulator": {
          "type": "string"
        },
        "status": {
          "enum": [
            "in_force",
            "coming"
          ],
          "type": "string"
        },
        "upcoming": {
          "additionalProperties": false,
          "description": "New law already passed but not yet in force.",
          "properties": {
            "effectiveFrom": {
              "type": "string"
            },
            "law": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "law",
            "effectiveFrom",
            "summary"
          ],
          "type": "object"
        }
      },
      "required": [
        "code",
        "name",
        "law",
        "regulator",
        "status",
        "maxPenalty",
        "penaltyHeadline",
        "citations",
        "precedents"
      ],
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "$ref": "#/definitions/CurrencyCode"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "PatternId": {
      "enum": [
        "false_urgency",
        "basket_sneaking",
        "confirm_shaming",
        "forced_action",
        "subscription_trap",
        "interface_interference",
        "bait_and_switch",
        "drip_pricing",
        "disguised_advertisement",
        "nagging",
        "trick_question",
        "saas_billing",
        "rogue_malware",
        "misleading_price"
      ],
      "type": "string"
    },
    "Precedent": {
      "additionalProperties": false,
      "description": "A real enforcement outcome for a similar practice.",
      "properties": {
        "amount": {
          "$ref": "#/definitions/Money"
        },
        "company": {
          "type": "string"
        },
        "confidence": {
          "description": "'official' = regulator or legislation; 'reported' = press or law-firm commentary.",
          "enum": [
            "official",
            "reported"
          ],
          "type": "string"
        },
        "date": {
          "description": "ISO date or year-month.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "jurisdiction": {
          "$ref": "#/definitions/JurisdictionCode"
        },
        "outcome": {
          "type": "string"
        },
        "patternIds": {
          "items": {
            "$ref": "#/definitions/PatternId"
          },
          "type": "array"
        },
        "regulator": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "jurisdiction",
        "company",
        "regulator",
        "date",
        "outcome",
        "patternIds",
        "summary",
        "sourceUrl",
        "confidence"
      ],
      "type": "object"
    },
    "PriceDrift": {
      "additionalProperties": false,
      "description": "What the shopper was told to expect versus what they are asked to pay. Measured by the agents.",
      "properties": {
        "advertised": {
          "$ref": "#/definitions/Money",
          "description": "Total the product page led the shopper to expect, including any fees disclosed there."
        },
        "claimedSaving": {
          "$ref": "#/definitions/Money",
          "description": "Saving the store claims, e.g. MRP minus price."
        },
        "genuineSaving": {
          "$ref": "#/definitions/Money",
          "description": "Saving against the genuine prior price."
        },
        "lines": {
          "items": {
            "$ref": "#/definitions/PriceDriftLine"
          },
          "type": "array"
        },
        "payable": {
          "$ref": "#/definitions/Money",
          "description": "Total on the payment step."
        },
        "savingFindingId": {
          "description": "Finding that disputes the claimed saving.",
          "type": "string"
        }
      },
      "required": [
        "advertised",
        "payable",
        "lines"
      ],
      "type": "object"
    },
    "PriceDriftLine": {
      "additionalProperties": false,
      "description": "A charge the shopper ends up paying that the product page did not show.",
      "properties": {
        "amount": {
          "$ref": "#/definitions/Money"
        },
        "findingId": {
          "description": "The finding that explains this charge, if any.",
          "type": "string"
        },
        "firstSeen": {
          "$ref": "#/definitions/JourneyStep",
          "description": "Step on which the shopper could first see this charge."
        },
        "kind": {
          "enum": [
            "sneaked_item",
            "subscription",
            "fee",
            "upgrade"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recurring": {
          "enum": [
            "monthly",
            "yearly"
          ],
          "type": "string"
        }
      },
      "required": [
        "label",
        "amount",
        "kind",
        "firstSeen"
      ],
      "type": "object"
    },
    "Record<string,RuleCitation>": {
      "additionalProperties": {
        "$ref": "#/definitions/RuleCitation"
      },
      "type": "object"
    },
    "RuleCitation": {
      "additionalProperties": false,
      "properties": {
        "clause": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verified": {
          "description": "False when only the instrument, not the exact clause, has been checked.",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "clause"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "StepCapture": {
      "additionalProperties": false,
      "properties": {
        "blockedReason": {
          "description": "Why the agent could not go further, e.g. \"Sign-in required\".",
          "type": "string"
        },
        "screenshotUrl": {
          "description": "For a blocked step, a screenshot of what stopped the agent (e.g. the sign-in wall), if any.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/StepStatus",
          "description": "Defaults to 'audited'. Steps after a blocked one are simply absent."
        },
        "step": {
          "$ref": "#/definitions/JourneyStep"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "url"
      ],
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "audited",
        "blocked"
      ],
      "type": "string"
    }
  }
}